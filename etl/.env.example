# Copie para etl/.env e preencha com valores reais. etl/.env nunca deve ir pro Git.

# --- Databricks (leitura) ---
# Não precisa de token/PAT: a conexão usa OAuth user-to-machine
# (auth_type="databricks-oauth" no script), que abre o navegador pra login na
# primeira vez e reusa/renova o token depois — mesma conta que você já usa
# pra acessar o workspace normalmente.
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# --- Neon (escrita) ---
# Usuário DEDICADO de carga (etl_loader), dono de core.* e org.* — nunca o
# neondb_owner. Tabelas: core.fato_* (mirror) e org.headcount_* (painel).
NEON_DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
