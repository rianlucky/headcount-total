# Copie este arquivo para "secrets.toml" (mesma pasta) e preencha com os valores reais.
# secrets.toml já está no .gitignore — nunca commitar esse arquivo com credenciais reais.

[neon]
# Connection string do projeto "Central de Gente & Dados" no Neon, com o usuário
# DEDICADO do painel (app_headcount) — nunca o neondb_owner. Esse usuário só lê
# org.headcount_* e o login (public.app_users); não enxerga core.* (PII).
# Host = endpoint primary do branch (main em produção, dev pra testar migração).
database_url = "postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require"
